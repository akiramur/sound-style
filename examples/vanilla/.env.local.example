# Copy this file to .env.local and set a real Mapbox access token.
# .env.local is gitignored and never committed.
VITE_MAPBOX_ACCESS_TOKEN=pk.your-mapbox-access-token

# Audio is loaded from this base URL. Defaults to the sound-style-assets CDN (served via
# jsDelivr) so the demo works out of the box. This app has no local public/audio-basic/ of its own
# (that's apps/dev-app's job) — point this at your own hosting instead if you need to override it.
VITE_AUDIO_BASE_URL=https://cdn.jsdelivr.net/gh/akiramur/sound-style-assets@v1.1.0/
