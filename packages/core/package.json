{
  "name": "@sound-style/core",
  "version": "0.0.0",
  "description": "Framework-agnostic declarative sound engine for Web Audio API, styled after the Mapbox GL Style Spec.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akiramur/sound-style.git",
    "directory": "packages/core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mapbox/mapbox-gl-style-spec": "catalog:",
    "ajv": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
